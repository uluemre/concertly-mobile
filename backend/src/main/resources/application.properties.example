# Concertly backend yapılandırma ŞABLONU
# -----------------------------------------------------------------------------
# Bu dosyayı kopyalayıp `application.properties` olarak kaydet ve değerleri doldur.
#   cp application.properties.example application.properties
# Gerçek `application.properties` .gitignore'da — secret'lar ASLA commit edilmez.
# Değerleri ortam değişkeninden (env) ya da doğrudan bu dosyaya yazabilirsin.
# -----------------------------------------------------------------------------

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/concertly_mobile}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:CHANGE_ME}

# Yerel geliştirme mevcut Hibernate şemasını güncelleyebilir. Production'da
# DDL_AUTO=validate ve FLYWAY_ENABLED=true kullan; şema değişikliklerini SQL
# migration dosyalarıyla uygula.
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.open-in-view=false
spring.flyway.enabled=${FLYWAY_ENABLED:false}
spring.flyway.baseline-on-migrate=${FLYWAY_BASELINE_ON_MIGRATE:false}
spring.flyway.baseline-version=${FLYWAY_BASELINE_VERSION:1}
spring.flyway.locations=classpath:db/migration

spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.deserialization.fail-on-unknown-properties=false
server.port=${PORT:8082}
management.endpoints.web.exposure.include=health,info
management.endpoint.health.probes.enabled=true
management.endpoint.health.show-details=never
# SMTP varsayılan olarak kapalıdır; bu durumda erişilemeyen SMTP sunucusunun
# uygulamayı health endpoint'inde DOWN göstermesine izin verme.
management.health.mail.enabled=${MAIL_HEALTH_ENABLED:false}

# Virgülle ayrılmış güvenilir istemci origin'leri. Production'da CORS_ALLOWED_ORIGIN_PATTERNS
# değerini sadece yayımlanan uygulama alan adlarıyla sınırlandır.
app.cors.allowed-origin-patterns=${CORS_ALLOWED_ORIGIN_PATTERNS:https://your-app.example.com}

# Görsel yükleme
app.upload.dir=${UPLOAD_DIR:uploads}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB

# JWT — en az 32 karakterlik GÜÇLÜ, rastgele bir secret üret (prod'da mutlaka değiştir)
jwt.secret=${JWT_SECRET:CHANGE_ME_USE_A_LONG_RANDOM_SECRET_32CHARS_MIN}
jwt.expiration.ms=3600000
jwt.refresh.expiration.days=30

# Spotify — https://developer.spotify.com/dashboard
spotify.client.id=${SPOTIFY_CLIENT_ID:CHANGE_ME}
spotify.client.secret=${SPOTIFY_CLIENT_SECRET:CHANGE_ME}
spotify.redirect.uri=${SPOTIFY_REDIRECT_URI:http://localhost:8082/api/spotify/callback}

# Ticketmaster — https://developer.ticketmaster.com
ticketmaster.api.key=${TICKETMASTER_API_KEY:CHANGE_ME}

# Admin bootstrap — bu e-postaya sahip kullanıcı açılışta ROLE_ADMIN yapılır
admin.bootstrap.email=${ADMIN_EMAIL:}

# E-posta (şifre sıfırlama) — Gmail SMTP. App Password gerekir (2FA açık olmalı).
app.mail.enabled=${MAIL_ENABLED:false}
app.mail.from=${MAIL_FROM:Concertly <no-reply@concertly.app>}
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
