{
  "expo": {
    "name": "Concertly",
    "slug": "concertly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.concertly.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:concertly-backend.onrender.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.concertly.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "concertly-backend.onrender.com",
              "pathPrefix": "/e"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "concertly-backend.onrender.com",
              "pathPrefix": "/a"
            },
            {
              "scheme": "https",
              "host": "concertly-backend.onrender.com",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "concertly-backend.onrender.com",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "concertly-backend.onrender.com",
              "pathPrefix": "/c"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Concertly, paylaşımların ve profil fotoğrafın için galerinden görsel seçmene izin ister.",
          "cameraPermission": "Concertly, paylaşımların için kamerayla fotoğraf çekmene izin ister.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Concertly, yakınındaki etkinlikleri ve mekanları haritada göstermek için konumunu kullanır."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Concertly, ilgilendiğin etkinlikleri takvimine eklemek için izin ister."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F1A",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F0F1A"
          },
          "android": {
            "image": "./assets/icon.png",
            "imageWidth": 200,
            "backgroundColor": "#0F0F1A",
            "dark": {
              "image": "./assets/icon.png",
              "backgroundColor": "#0F0F1A"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E94560",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://concertly-backend.onrender.com/api",
      "eas": {
        "projectId": "9089b703-90c1-4c42-b444-7f2dcf39a4cb"
      }
    },
    "owner": "uemre",
    "scheme": "concertly"
  }
}
